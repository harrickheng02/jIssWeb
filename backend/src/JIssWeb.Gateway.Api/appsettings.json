{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Issuer": "JIssWeb",
    "Audience": "JIssWeb",
    "Key": "change-me-in-production-use-32-chars-min!!"
  },
  "ReverseProxy": {
    "Routes": {
      "auth-route": {
        "ClusterId": "user-service",
        "Match": {
          "Path": "/api/auth/{**catch-all}"
        }
      },
      "customer-route": {
        "ClusterId": "customer-service",
        "Match": {
          "Path": "/api/customers/{**catch-all}"
        }
      },
      "profile-route": {
        "ClusterId": "customer-service",
        "Match": {
          "Path": "/api/profile/{**catch-all}"
        }
      },
      "bff-route": {
        "ClusterId": "frontend-bff",
        "Match": {
          "Path": "/api/bff/{**catch-all}"
        }
      },
      "forum-route": {
        "ClusterId": "model-service",
        "Match": {
          "Path": "/api/forum/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "user-service": {
        "Destinations": {
          "d1": {
            "Address": "http://localhost:5097/"
          }
        }
      },
      "customer-service": {
        "Destinations": {
          "d1": {
            "Address": "http://localhost:5098/"
          }
        }
      },
      "frontend-bff": {
        "Destinations": {
          "d1": {
            "Address": "http://localhost:5095/"
          }
        }
      },
      "model-service": {
        "Destinations": {
          "d1": {
            "Address": "http://localhost:5099/"
          }
        }
      }
    }
  }
}
